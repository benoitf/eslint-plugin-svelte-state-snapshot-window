{
  "name": "eslint-plugin-svelte-state-snapshot-window",
  "version": "1.0.0",
  "description": "ESLint rules to enforce $state.snapshot usage when passing Svelte $state variables to window.* calls (Electron IPC).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/benoitf/eslint-plugin-svelte-state-snapshot-window"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "svelte",
    "electron",
    "$state"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@typescript-eslint/utils": "^8.45.0",
    "eslint": "^9",
    "typescript": "^5.2.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "eslint": "^9"
  },

  "packageManager": "pnpm@10.18.0+sha512.e804f889f1cecc40d572db084eec3e4881739f8dec69c0ff10d2d1beff9a4e309383ba27b5b750059d7f4c149535b6cd0d2cb1ed3aeb739239a4284a68f40cfa"
}
